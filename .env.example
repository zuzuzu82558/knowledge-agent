# offline: no model/cloud/telemetry requests; local: cloud models + local Qdrant;
# cloud: cloud models + Qdrant Cloud. Never commit .env.
APP_MODE=offline
DATA_DIR=data
MODEL_API_KEY=
# LiteLLM provider/model identifiers; examples require provider access verification.
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_REVISION=provider-default
# Optional compatible gateway, include /v1 when your provider requires it.
# MODEL_API_BASE=https://your-provider.example/v1
QDRANT_URL=
QDRANT_API_KEY=
COLLECTION_PREFIX=knowledge_m1
MAX_UPLOAD_MB=20
MAX_CHUNKS=2000
# Exact evidence JSON UTF-8 bytes. CONTEXT_TOKENS remains a legacy byte alias.
EVIDENCE_BUDGET_BYTES=3000
# Includes serialized messages plus conservative output reserve (8 bytes/token).
# This is a byte guard, not the provider's tokenizer/context-window guarantee.
MODEL_REQUEST_BUDGET_BYTES=64000
GENERATION_MAX_TOKENS=1200
REQUEST_TIMEOUT=60
MODEL_CALL_TIMEOUT=60
# Model deadlines start AFTER parsing; successful embedding batches persist.
BACKGROUND_TIMEOUT=1800
BACKGROUND_MAX_MODEL_CALLS=5000
EMBEDDING_BATCH_SIZE=32
# auto: OpenAI/Azure/Mistral symmetric, Cohere search_document/query, Voyage document/query.
# Other providers must choose a verified explicit profile. Prefix mode includes BOTH prefixes in the contract.
EMBEDDING_INPUT_PROFILE=auto
EMBEDDING_DOCUMENT_PREFIX=
EMBEDDING_QUERY_PREFIX=
# Changes to these values or embedding identity/input contract require explicit index rebuild.
CHUNK_STRATEGY=legacy
CHUNK_SIZE=900
CHUNK_OVERLAP=0
# boundary preserves paragraph/sentence boundaries where possible; overlap optional, not assumed better.
RETRIEVAL_BRANCH_LIMIT=20
RETRIEVAL_CANDIDATE_POOL=24
RETRIEVAL_TOP_K=8
RRF_K=60

# Independent generation/embedding credentials override shared MODEL_API_KEY/BASE.
LLM_API_KEY=
LLM_API_BASE=
# Provider-specific JSON body for generation only. DeepSeek: {"thinking":{"type":"disabled"}}
# Qwen chat: {"enable_thinking":false}. Change this when switching providers.
LLM_EXTRA_BODY={}
EMBEDDING_API_KEY=
EMBEDDING_API_BASE=
# Example: Qwen OpenAI-compatible embedding uses text-embedding-v3, 1024 dims,
# EMBEDDING_BATCH_SIZE=10 and EMBEDDING_INPUT_PROFILE=symmetric.
# Optional compatible backup generation model; same credential/gateway by default.
FALLBACK_MODEL=
MAX_MODEL_CALLS=40
RETRY_ATTEMPTS=1
# Graph extraction sends document chunks to the configured LLM (paid in local/cloud).
GRAPH_ENABLED=false
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_CAPACITY=100
SEMANTIC_THRESHOLD=0.98
# Upstash Redis REST URL + token, not redis://. Offline never contacts Redis.
REDIS_URL=
REDIS_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Optional LLM listwise reranking provider/model; uses generation credentials.
RERANK_MODEL=
RAGAS_DO_NOT_TRACK=true

# Official Tavily API, configured on SERVER only; offline NEVER calls the network.
SEARCH_PROVIDER=disabled
SEARCH_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT=10
SEARCH_MAX_CALLS=3
WEB_TIMEOUT=10
WEB_MAX_BYTES=1000000
WEB_MAX_TEXT_CHARS=30000
WEB_CONCURRENCY=3
WEB_MAX_REDIRECTS=3
WEB_MAX_PAGES=6
AGENT_MAX_ROUNDS=2
